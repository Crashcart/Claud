# ─── Brainerd AI Configuration ─────────────────────────────────────────────

# Ollama settings (required - local inference)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=mistral:7b
# Alternative lightweight model for low-CPU moments:
# OLLAMA_MODEL=phi3:mini

# Google Gemini AI (optional - leave blank to disable)
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# AI routing: "ollama" | "google" | "auto"
# "auto" uses Google if key is set, falls back to Ollama
AI_PROVIDER=auto

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production-32chars+

# Database (SQLite default — uses disk, not CPU)
DATABASE_URL=sqlite+aiosqlite:////data/brainerd.db

# Inter-container comms
# Other containers connect via: http://brainerd:8000
# Or via the shared Docker network "brainerd_net"
ALLOWED_ORIGINS=*

# RPG settings
RPG_MAX_HISTORY=50
RPG_DEFAULT_WORLD=fantasy

# Logging
LOG_LEVEL=INFO
